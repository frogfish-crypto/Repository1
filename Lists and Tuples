# # 9. Write a function called isCaps with one argument that returns True if all strings in the list have at least one capital letter, False if not.

def isCaps(list):
    boolean=False
    check=0
    for i in range (0,len(list)):
        for char in list[i]:
            if char.isupper():
                check+=1
    if check>=len(list):     
        boolean=True       
    return boolean
            
