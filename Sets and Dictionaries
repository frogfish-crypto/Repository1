







# 1. Write a function called firstLetter that accepts two arguments (set, letter) and returns how many items in the set have that letter as the first letter (ignore case)

def firstLetter(set, letter):
    letterCount=0
    for x in set:
        if x[0]==letter:
            letterCount+=1
    return letterCount

letter="A"
set={"Apple", "Banana", "Apricot"}
lettercount=firstLetter(set, letter)
print(lettercount)

# 2. Write a function called valueCheck that accepts two arguments (dict, val) and returns a list of all keys with the associated value.

def valueCheck(my_dict, val):
    keyList=[]
    for x in my_dict:
        if my_dict[x] == val:
            keyList.append(x)
    return keyList


my_dict={
    "Georgia":400,
    "California":1200,
    "New York":400
}
val=400
keyList=valueCheck(my_dict, val)
print(keyList)

