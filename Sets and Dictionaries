# 5. Write a function called removeCommon that accepts two arguments (set, dict) and removes all keys from the dictionary that are found in set, then adds those removed keys to a new dictionary and returns it.

def removeCommon(set, dict1):
    removed={}
    for x in dict1.keys():
        if x in set:
            dict1.pop(x)
        removed[x]=[dict1(x)]
    return removed

dict1={
    "score1":70,
    "score2":80,
    "score3":40
}
set={"score1","superman",30}
removed=removeCommon(set, dict1)
print(removed)

