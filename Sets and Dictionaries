# 5. Write a function called removeCommon that accepts two arguments (set, dict) and removes all keys from the dictionary that are found in set, then adds those removed keys to a new dictionary and returns it.

def removeCommon(set, dict1):
    removed={}
    for x in list(dict1.keys()):
        if x in set:
            removed[x]=[dict1[x]]
            dict1.pop(x)
    return removed

dict1={
    "score1":70,
    "score2":80,
    "score3":40
}
set={"score1","superman",30}
removed=removeCommon(set, dict1)
print(removed)

#6. Write a function called itemList that accepts one argument (dict) and returns a list of tuples of all its key - value pairs. Do NOT use the built-in .items() function.

def itemList(dict):
    itemList=[]
    for x in dict:
        tuple=(x,dict[x])
        itemList.append(tuple)
    return itemList

dict={
    "score1":70,
    "score2":80,
    "score3":40
}
print(itemList(dict))


# 7. Write a function called addDict that accepts two arguments (dict1, dict2) and joins the two together into a new dictionary. If there is a repeated key, add their values together.
# ex:
# dict1: {"one": 1, "two": 3}
# dict2: {"one": 3}
# the function should return {"one": 4, "two": 3}

def addDict(dict1, dict2):
    addDict={}
    for x in dict1:
        addDict[x]=dict1[x]
    for x in dict2:
        addDict[x]=dict2[x]
        if x in dict1:
            addDict[x]=dict2[x]+dict1[x]
    return addDict

dict1= {
     "one": 1, 
     "two": 3
     }

dict2= {
    "two": 10
    }

print(addDict(dict1, dict2))

