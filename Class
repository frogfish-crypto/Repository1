        super().__init__(firstName, lastName, currentYear)    
        self.__seatNum=seatNum
        self.__homeroom=homeroom

    def getAP(self):
        return self.listAP

    def addAP(self, newAP, score):
        self.listAP={}
        self.listAP[newAP]=score

    def getSAT(self):
        return self.getSAT
    
    def addSAT(self, newSAT):
        self.newSAT=[]
        self.newSAT.append(newSAT)

    def highestSAT(self):
        for i in range(0,len(self.newSAT)):
            highest=self.newSAT[0]
            if self.newSAT[i]>highest:
                highest=self.newSAT[i]
            return highest

    def getHomeroom(self):
        return self.getHomeroom

    def getSeat(self):
       return self.getSeat

    def changeClass(self, newSeatNum, newHomeroom):
        self.__seatNum=newSeatNum
        self.__homeroom=newHomeroom
        return self.__seatNum, self.__homeroom

    def advanceYear(self, seatNum, homeroom):
        self.currentYear=0
        self.__seatNum=seatNum
        self.__homeroom=homeroom
        self.currentYear=self.currentYear+1
        return self.__seatNum, self.__homeroom, self.currentYear

    def canGraduate(self):
        if self.currentYear==4 and len(self.listAP)>=15:
            return True

